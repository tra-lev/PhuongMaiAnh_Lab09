@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner"><h3>@ViewBag.CategoryCount</h3><p>Danh mục</p></div>
            <div class="icon"><i class="fas fa-list"></i></div>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="small-box-footer">Xem thêm <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner"><h3>@ViewBag.ProductCount</h3><p>Sản phẩm</p></div>
            <div class="icon"><i class="fas fa-box"></i></div>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="small-box-footer">Xem thêm <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner"><h3>@ViewBag.BannerCount</h3><p>Banner</p></div>
            <div class="icon"><i class="fas fa-images"></i></div>
            <a asp-area="Admin" asp-controller="Banner" asp-action="Index" class="small-box-footer">Xem thêm <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner"><h3>@ViewBag.BlogCount</h3><p>Bài viết</p></div>
            <div class="icon"><i class="fas fa-newspaper"></i></div>
            <a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="small-box-footer">Xem thêm <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
</div>
