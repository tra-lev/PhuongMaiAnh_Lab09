@model Banner
@{
    ViewData["Title"] = "Xóa banner";
}

<div class="card card-danger">
    <div class="card-header">
        <h3 class="card-title">Bạn có chắc muốn xóa banner này?</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Id)</dt>
            <dd class="col-sm-9">@Model.Id</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Priority)</dt>
            <dd class="col-sm-9">@Model.Priority</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Status)</dt>
            <dd class="col-sm-9">@if (Model.Status == 1) { <span class="badge badge-success">Hiển thị</span> } else { <span class="badge badge-secondary">Ẩn</span> }</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Image)</dt>
            <dd class="col-sm-9">@if (!string.IsNullOrEmpty(Model.Image)) { <img src="@Model.Image" style="height:120px" class="img-thumbnail" /> }</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Xóa</button>
        </form>
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
    </div>
</div>
