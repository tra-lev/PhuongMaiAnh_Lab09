@model IEnumerable<Product>
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Danh sách sản phẩm</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm mới</a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-bordered table-hover table-striped mb-0">
            <thead class="thead-light">
                <tr>
                    <th style="width:60px">#</th>
                    <th>@Html.DisplayNameFor(m => m.First().Image)</th>
                    <th>@Html.DisplayNameFor(m => m.First().Name)</th>
                    <th>@Html.DisplayNameFor(m => m.First().Category)</th>
                    <th>@Html.DisplayNameFor(m => m.First().Price)</th>
                    <th>@Html.DisplayNameFor(m => m.First().SalePrice)</th>
                    <th>@Html.DisplayNameFor(m => m.First().Status)</th>
                    <th>@Html.DisplayNameFor(m => m.First().CreatedDate)</th>
                    <th style="width:140px" class="text-center">Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">Chưa có dữ liệu</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">@item.Id</td>
                        <td class="text-center">@if (!string.IsNullOrEmpty(item.Image)) { <img src="@item.Image" style="height:50px;max-width:80px;object-fit:cover" /> }</td>
                        <td>@item.Name</td>
                        <td>@item.Category?.Name</td>
                        <td class="text-right">@item.Price.ToString("N0")</td>
                        <td class="text-right">@item.SalePrice.ToString("N0")</td>
                        <td class="text-center">@if (item.Status == 1) { <span class="badge badge-success">Hiển thị</span> } else { <span class="badge badge-secondary">Ẩn</span> }</td>
                        <td class="text-center">@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="Chi tiết"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Sửa"><i class="fas fa-edit"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Xóa"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
