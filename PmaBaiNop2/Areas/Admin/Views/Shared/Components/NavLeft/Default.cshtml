@model List<PmaMenuItem>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="brand-link">
        <img src="~/dist/img/AdminLTELogo.png" alt="Logo" class="brand-image img-circle elevation-3" style="opacity:.8">
        <span class="brand-text font-weight-light">Admin cPanel</span>
    </a>

    <div class="sidebar">
        <div class="user-panel mt-3 pb-3 mb-3 d-flex">
            <div class="image">
                <img src="~/dist/img/user2-160x160.jpg" class="img-circle elevation-2" alt="User">
            </div>
            <div class="info">
                <a href="#" class="d-block">Phương Mai Anh</a>
            </div>
        </div>

        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                @foreach (var item in Model)
                {
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="@item.Controller" asp-action="Index"
                           class="nav-link @(item.Controller == currentController ? "active" : "")">
                            <i class="nav-icon @item.Icon"></i>
                            <p>@item.Title</p>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</aside>
